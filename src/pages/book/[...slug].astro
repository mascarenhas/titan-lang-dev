---
import { getCollection, render } from "astro:content";
import DocsLayout from "@titan-lang/cassini/layouts/DocsLayout.astro";
import { findPrevNext } from "@titan-lang/cassini/nav";
import { BOOK_PDF_CTA, SITE, getBookToc } from "../../site.config.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("book");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = headings.find((h) => h.depth === 1)?.text ?? entry.id;
const toc = getBookToc();
const currentHref = entry.id === "index" ? "/book/" : `/book/${entry.id}/`;
const { prev, next } = findPrevNext(toc.readingOrder, currentHref);

let kicker = `The Titan Programming Language · ${SITE.versionBadge}`;
if (entry.id !== "index") {
  let matched = false;
  for (const part of toc.parts) {
    const found = part.entries.find((e) => e.slug === entry.id);
    if (found) {
      const partLabel = part.title.split("—")[0].trim();
      kicker = found.kicker ? `${partLabel} · ${found.kicker}` : partLabel;
      matched = true;
      break;
    }
  }
  if (!matched && entry.id.startsWith("uv/")) {
    kicker = "Low-Level libuv Bindings Reference";
  }
}
---

<DocsLayout
  title={title}
  pageTitle={entry.id === "index" ? `The Titan Programming Language — ${SITE.brandName}` : `${title} — The Titan Programming Language`}
  description={`${title} — The Titan Programming Language (${SITE.versionBadge})`}
  brandName={SITE.brandName}
  projectLabel={SITE.projectLabel}
  logoSrc={SITE.logoSrc}
  versionBadge={SITE.versionBadge}
  navLinks={SITE.navLinks}
  githubUrl={SITE.githubUrl}
  siteUrl={SITE.siteUrl}
  siteLabel={SITE.siteLabel}
  licenseUrl={SITE.licenseUrl}
  searchPlaceholder={SITE.searchPlaceholder}
  sidebarGroups={toc.sidebarGroups}
  sidebarCta={BOOK_PDF_CTA}
  headings={headings}
  prev={prev}
  next={next}
  sectionLabel="Book"
  kicker={kicker}
>
  <Content />
</DocsLayout>
