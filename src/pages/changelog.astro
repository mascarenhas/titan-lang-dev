---
import { getEntry, render } from "astro:content";
import BaseLayout from "@titan-lang/cassini/layouts/BaseLayout.astro";
import { SITE } from "../site.config.mjs";

const entry = await getEntry("site", "changelog");
if (!entry) throw new Error("Missing src/content/site/changelog.md");
const { Content } = await render(entry);
const title = (entry.data as { title?: string })?.title || "Changelog";
const description = (entry.data as { description?: string })?.description;
---

<BaseLayout
  title={`${title} — ${SITE.brandName}`}
  description={description}
  brandName={SITE.brandName}
  projectLabel={SITE.projectLabel}
  logoSrc={SITE.logoSrc}
  versionBadge={SITE.versionBadge}
  navLinks={SITE.navLinks}
  githubUrl={SITE.githubUrl}
  siteUrl={SITE.siteUrl}
  siteLabel={SITE.siteLabel}
  licenseUrl={SITE.licenseUrl}
  searchPlaceholder={SITE.searchPlaceholder}
>
  <main class="single-page" data-pagefind-body data-pagefind-meta="section:Changelog">
    <article class="prose">
      <Content />
    </article>
  </main>
</BaseLayout>
