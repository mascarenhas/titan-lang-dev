---
import { getCollection, render } from "astro:content";
import DocsLayout from "@titan-lang/cassini/layouts/DocsLayout.astro";
import { findPrevNext, flattenSidebar } from "@titan-lang/cassini/nav";
import { SITE, VSCODE_SIDEBAR } from "../../site.config.mjs";

export async function getStaticPaths() {
  const entries = await getCollection("vscode");
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const title = headings.find((h) => h.depth === 1)?.text ?? entry.id;
const currentHref = `/vscode/${entry.id}/`;
const { prev, next } = findPrevNext(flattenSidebar(VSCODE_SIDEBAR), currentHref);
const group = VSCODE_SIDEBAR.find((g) => g.items.some((i) => i.href === currentHref));
const kicker = group ? `VS Code & LSP · ${group.title}` : "VS Code & Language Server";
---

<DocsLayout
  title={title}
  pageTitle={`${title} — Titan VS Code & LSP`}
  description={`${title} — Titan VS Code extension and language server documentation.`}
  brandName={SITE.brandName}
  projectLabel={SITE.projectLabel}
  logoSrc={SITE.logoSrc}
  versionBadge={SITE.versionBadge}
  navLinks={SITE.navLinks}
  githubUrl={SITE.vscodeGithubUrl}
  siteUrl={SITE.siteUrl}
  siteLabel={SITE.siteLabel}
  licenseUrl={SITE.licenseUrl}
  searchPlaceholder={SITE.searchPlaceholder}
  sidebarGroups={VSCODE_SIDEBAR}
  headings={headings}
  prev={prev}
  next={next}
  sectionLabel="VS Code"
  kicker={kicker}
>
  <Content />
</DocsLayout>
