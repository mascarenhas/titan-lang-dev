--- Data model for Saturn's major moons.

--- A major natural satellite orbiting Saturn.
record Moon
  const name: string
  const radius_km: float
  const period_days: float
end

--- Return this moon's orbital period in hours.
function Moon:period_hours(): float
  return self.period_days * 24.0
end

--- Return five major moons of Saturn ordered by radius.
function saturnian(): {Moon}
  return {
    Moon("Titan", 2574.7, 15.945),
    Moon("Rhea", 763.8, 4.518),
    Moon("Iapetus", 734.5, 79.33),
    Moon("Dione", 561.4, 2.737),
    Moon("Enceladus", 252.1, 1.370),
  }
end
